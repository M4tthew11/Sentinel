# Copy to .env and fill in. Every variable here is optional - Sentinel runs
# end-to-end with no configuration at all.

# --- Agent ---------------------------------------------------------------
# Without a key the agent falls back to the deterministic rule-based engine,
# so the demo and the eval harness still run (see docs/adr/0003-agent-fallback.md).
# ANTHROPIC_API_KEY=sk-ant-...
SENTINEL_AGENT__PROVIDER=auto          # auto | claude | rules
SENTINEL_AGENT__MODEL=claude-opus-5
SENTINEL_AGENT__EFFORT=medium          # low | medium | high | xhigh | max
SENTINEL_AGENT__MAX_TOOL_CALLS=8

# --- Reviewer ------------------------------------------------------------
# A second, independent opinion on every proposed action. It sees the incident
# and the action, never the first agent's reasoning. Only what it approves runs
# without a human; high-risk and out-of-scope actions go to a human regardless.
SENTINEL_REVIEWER__PROVIDER=auto       # auto | claude | rules | off
SENTINEL_REVIEWER__MODEL=claude-opus-5
SENTINEL_REVIEWER__EFFORT=medium
SENTINEL_REVIEWER__MAX_TOOL_CALLS=6

# --- Remediation ---------------------------------------------------------
# manual  -> every action needs human approval
# auto    -> low-risk actions the reviewer approves execute automatically;
#            risky or doubted ones still need approval
SENTINEL_REMEDIATION__MODE=auto

# --- Approvals -----------------------------------------------------------
# name:token pairs (tokens at least 16 characters). When set, approve/reject
# requires "Authorization: Bearer <token>" and records the token's name as the
# approver. When unset, approvals are accepted only from localhost.
# SENTINEL_APPROVER_TOKENS=alice:change-me-to-a-long-random-string

# --- Storage -------------------------------------------------------------
SENTINEL_DATA_DIR=./data
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_FORMAT=console            # console | json
